# ComPDF — configuración de build (sin secretos; se versiona en git)
# Todas las rutas asumen que el sitio se sirve en /ComPDF/ (GitHub Pages: usuario.github.io/ComPDF/).
# Si cambias el nombre del repositorio o la ruta, actualiza "/ComPDF/" aquí y BASE_URL en el workflow.

# Marca
VITE_BRAND_NAME=ComPDF
VITE_BRAND_LOGO=images/compdf-logo.svg
VITE_FOOTER_TEXT="ComPDF · basado en BentoPDF (AGPL-3.0) · Código fuente: github.com/juancah27/ComPDF"
VITE_DEFAULT_LANGUAGE=es

# Módulos WASM servidos desde el mismo sitio (sin CDN externo)
VITE_WASM_PYMUPDF_URL=/ComPDF/wasm/pymupdf/
VITE_WASM_GS_URL=/ComPDF/wasm/gs/assets/
VITE_WASM_CPDF_URL=/ComPDF/wasm/cpdf/dist/

# OCR local (inglés y español)
VITE_TESSERACT_WORKER_URL=/ComPDF/wasm/ocr/worker.min.js
VITE_TESSERACT_CORE_URL=/ComPDF/wasm/ocr/core
VITE_TESSERACT_LANG_URL=/ComPDF/wasm/ocr/lang-data
VITE_TESSERACT_AVAILABLE_LANGUAGES=eng,spa
VITE_OCR_FONT_BASE_URL=/ComPDF/wasm/ocr/fonts
